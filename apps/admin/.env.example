# Backend API origin the admin console calls. The server must allowlist this
# console's origin for credentialed CORS (config.cors_allow_origins). Defaults to
# http://localhost:8000 when unset.
# Production build uses .env.production (app.fashitianxia.xyz/api). Override via
# AGENTCORE_APP_API_URL / AGENTCORE_APP_HOST / AGENTCORE_OFFICE_HOST for
# deploy-production.mjs (loaded from deploy/.env.deploy.local).
VITE_API_URL=http://localhost:8000
