# Backend API origin the admin console calls. The server must allowlist this
# console's origin for credentialed CORS (config.cors_allow_origins). Defaults to
# http://localhost:8000 when unset.
# Production (office.example.com via reverse proxy / Tunnel + Nginx):
#   VITE_API_URL=https://app.example.com/api
# Or set AGENTCORE_APP_API_URL / AGENTCORE_OFFICE_HOST for deploy-production.mjs
VITE_API_URL=http://localhost:8000
