/* AgentTown observer chrome — top status / bottom transport / side rails.
   Root ignores picking so only chrome panels capture input over the 3D stage. */

.town-hud {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
}

.hidden {
    display: none;
}

.chrome {
    flex-direction: row;
    align-items: center;
    background-color: rgba(12, 14, 18, 0.88);
    border-color: rgba(255, 255, 255, 0.06);
    padding: 8px 14px;
}

.top-bar {
    justify-content: space-between;
    border-bottom-width: 1px;
    min-height: 64px;
    flex-shrink: 0;
    padding-top: 10px;
    padding-bottom: 10px;
}

.bottom-bar {
    justify-content: space-between;
    border-top-width: 1px;
    min-height: 56px;
    flex-shrink: 0;
    padding-top: 10px;
    padding-bottom: 10px;
}

.top-left {
    flex-direction: column;
    flex-shrink: 1;
    min-width: 220px;
    max-width: 480px;
}

.top-meta-row {
    flex-direction: row;
    align-items: center;
}

.stage {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    min-height: 0;
}

.stage-center {
    flex-grow: 1;
    min-width: 120px;
}

.panel {
    background-color: rgba(16, 18, 24, 0.9);
    border-radius: 10px;
    padding: 10px 12px;
    margin: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

.left-rail {
    width: 248px;
    max-height: 100%;
    margin-right: 0;
}

.right-rail {
    width: 292px;
    max-height: 100%;
    margin-left: 0;
    flex-direction: column;
}

.control-scroll {
    flex-grow: 1;
}

.status {
    color: rgb(236, 238, 244);
    font-size: 17px;
    white-space: normal;
    margin-bottom: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-grow: 1;
}

.mode-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.mode-badge {
    font-size: 15px;
    -unity-font-style: bold;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-right: 8px;
    border-radius: 3px;
    background-color: rgb(55, 62, 78);
    color: rgb(180, 190, 210);
}

.mode-badge--offline {
    background-color: rgb(40, 90, 70);
    color: rgb(170, 230, 190);
}

.mode-badge--live {
    background-color: rgb(50, 70, 110);
    color: rgb(170, 200, 255);
}

.mode-badge--replay {
    background-color: rgb(90, 70, 40);
    color: rgb(230, 200, 140);
}

.story-beat {
    color: rgb(210, 195, 150);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 2px;
    margin-top: 1px;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
}

.timeline-story {
    color: rgb(180, 190, 210);
    font-size: 10px;
    margin-left: 8px;
    min-width: 100px;
    max-width: 200px;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pack-intro-card {
    position: absolute;
    left: 50%;
    top: 22%;
    translate: -50% 0;
    width: 420px;
    max-width: 90%;
    background-color: rgba(14, 16, 24, 0.94);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 18px 20px;
    flex-direction: column;
    align-items: stretch;
}

.pack-intro-card.hidden {
    display: none;
}

.pack-intro-title {
    color: rgb(236, 238, 244);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.pack-intro-synopsis {
    color: rgb(190, 198, 214);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 10px;
}

.pack-intro-cast {
    flex-direction: column;
    margin-bottom: 12px;
}

.pack-intro-cast-row {
    color: rgb(170, 180, 200);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 4px;
}

.pack-intro-dismiss {
    align-self: flex-end;
    min-width: 100px;
}

.pack-dropdown {
    margin-bottom: 6px;
    min-height: 24px;
}

.boot-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 10, 16, 0.72);
    align-items: center;
    justify-content: center;
    picking-mode: Ignore;
}

.boot-overlay.hidden {
    display: none;
}

.boot-status {
    color: rgb(230, 235, 245);
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgba(20, 24, 34, 0.9);
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-radius: 6px;
}

.tick {
    color: rgb(170, 190, 235);
    font-size: 16px;
    margin-right: 12px;
}

.fps {
    color: rgb(150, 175, 155);
    font-size: 13px;
    margin-right: 12px;
    min-width: 56px;
}

/* §14 #5 band: ≥30 ok · 20–29 warn · &lt;20 critical (FpsSampler) */
.fps-ok {
    color: rgb(120, 200, 140);
}

.fps-warn {
    color: rgb(220, 180, 90);
}

.fps-critical {
    color: rgb(230, 110, 100);
}

.fps-unknown {
    color: rgb(150, 175, 155);
}

.stream {
    color: rgb(150, 160, 180);
    font-size: 13px;
}

.clock {
    color: rgb(230, 205, 150);
    font-size: 18px;
    -unity-font-style: bold;
    margin-right: 14px;
}

.section-title {
    color: rgb(140, 146, 160);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin-top: 8px;
    margin-bottom: 4px;
}

.section-subtitle {
    color: rgb(110, 116, 130);
    font-size: 10px;
    margin-top: 4px;
    margin-bottom: 2px;
}

.run-history-list {
    max-height: 88px;
    margin-bottom: 4px;
}

.run-history-row {
    flex-direction: column;
    background-color: rgba(38, 42, 54, 0.55);
    border-radius: 6px;
    padding: 5px 7px;
    margin-bottom: 3px;
}

.run-history-row:hover {
    background-color: rgba(58, 64, 82, 0.85);
}

.run-history-id {
    color: rgb(210, 218, 232);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.run-history-meta {
    color: rgb(130, 136, 150);
    font-size: 10px;
}

.run-history-empty {
    color: rgb(120, 126, 140);
    font-size: 11px;
    margin-bottom: 2px;
}

.row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.speed-row {
    flex-direction: row;
    align-items: center;
}

.transport-left,
.transport-center,
.transport-right {
    flex-direction: row;
    align-items: center;
}

.transport-center {
    flex-grow: 1;
    margin-left: 12px;
    margin-right: 12px;
    max-width: 720px;
}

.transport-right {
    flex-shrink: 0;
}

.grow {
    flex-grow: 1;
}

.btn {
    background-color: rgba(48, 54, 70, 0.95);
    color: rgb(233, 236, 244);
    border-radius: 7px;
    border-width: 0;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-left: 2px;
    margin-right: 2px;
    font-size: 12px;
    transition-duration: 0.1s;
}

.btn:hover {
    background-color: rgba(68, 76, 98, 1);
}

.btn:disabled {
    opacity: 0.4;
}

.btn.primary {
    background-color: rgb(46, 106, 210);
}

.btn.primary:hover {
    background-color: rgb(64, 124, 228);
}

.btn.accent {
    background-color: rgb(48, 118, 88);
}

.btn.accent:hover {
    background-color: rgb(64, 138, 104);
}

.btn.ghost {
    background-color: rgba(255, 255, 255, 0.06);
    margin-left: 8px;
}

.btn.ghost:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.btn.icon {
    min-width: 36px;
    -unity-text-align: middle-center;
}

.btn.play-main {
    min-width: 44px;
    background-color: rgb(46, 106, 210);
}

.btn.play-main:hover {
    background-color: rgb(64, 124, 228);
}

.btn.speed {
    min-width: 40px;
    -unity-text-align: middle-center;
    font-size: 11px;
    padding-left: 6px;
    padding-right: 6px;
}

.btn.speed.active {
    background-color: rgb(38, 90, 166);
}

.run-field {
    margin-right: 4px;
    min-width: 0;
}

.tab-row {
    flex-direction: row;
    margin-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 8px;
    padding: 2px;
}

.tab {
    flex-grow: 1;
    background-color: transparent;
    color: rgb(150, 156, 170);
    border-radius: 6px;
    border-width: 0;
    padding-top: 5px;
    padding-bottom: 5px;
    margin: 1px;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.tab:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(220, 224, 234);
}

.tab.active {
    background-color: rgba(46, 106, 210, 0.45);
    color: rgb(236, 240, 250);
}

.tab-pane {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.tab-pane.hidden {
    display: none;
}

.residents-list {
    flex-grow: 1;
    min-height: 140px;
    max-height: 280px;
}

.resident-row {
    flex-direction: column;
    background-color: rgba(38, 42, 54, 0.55);
    border-radius: 7px;
    padding: 6px 8px;
    margin-bottom: 3px;
}

.resident-row:hover {
    background-color: rgba(58, 64, 82, 0.8);
}

.resident-row.selected {
    background-color: rgba(46, 106, 210, 0.35);
    border-width: 1px;
    border-color: rgba(90, 150, 240, 0.55);
}

.resident-name {
    color: rgb(233, 236, 244);
    font-size: 12px;
}

.resident-meta {
    color: rgb(150, 156, 170);
    font-size: 10px;
}

.resident-detail {
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.07);
    max-height: 220px;
}

.detail-hint {
    color: rgb(140, 146, 160);
    font-size: 11px;
    white-space: normal;
}

.detail-title {
    color: rgb(233, 236, 244);
    font-size: 13px;
    -unity-font-style: bold;
}

.detail-sub {
    color: rgb(150, 156, 170);
    font-size: 11px;
    margin-bottom: 4px;
}

.detail-bio {
    color: rgb(206, 212, 224);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 6px;
}

.detail-section {
    color: rgb(170, 176, 190);
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 2px;
}

.detail-line {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.detail-key {
    color: rgb(150, 156, 170);
    font-size: 11px;
}

.detail-value {
    color: rgb(224, 228, 238);
    font-size: 11px;
}

.trait-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.trait-label {
    color: rgb(150, 156, 170);
    font-size: 10px;
    width: 48px;
}

.trait-track {
    flex-grow: 1;
    height: 5px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
}

.trait-fill {
    height: 5px;
    background-color: rgb(90, 150, 240);
    border-radius: 3px;
}

.observe-list {
    flex-grow: 1;
    min-height: 200px;
    max-height: 520px;
}

.observe-row {
    flex-direction: column;
    background-color: rgba(38, 42, 54, 0.5);
    border-radius: 6px;
    padding: 5px 7px;
    margin-bottom: 3px;
}

.observe-meta {
    color: rgb(130, 136, 150);
    font-size: 10px;
}

.observe-summary {
    color: rgb(220, 228, 240);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 2px;
}

.observe-detail {
    color: rgb(170, 180, 198);
    font-size: 11px;
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 1px;
}

.observe-empty {
    color: rgb(120, 126, 140);
    font-size: 11px;
}

.seek-slider {
    margin-left: 8px;
    margin-right: 4px;
    height: 18px;
    min-width: 120px;
}

.metrics-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 8px;
}

.metric-chip {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(200, 210, 230);
    border-radius: 999px;
    padding: 4px 10px;
    margin-right: 4px;
    margin-bottom: 2px;
    font-size: 13px;
}

.modifier-chips {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 22px;
    max-width: 220px;
}

.mod-chip {
    border-radius: 999px;
    padding: 3px 8px;
    margin-right: 4px;
    margin-bottom: 2px;
    font-size: 10px;
    color: rgb(233, 236, 244);
    background-color: rgba(58, 64, 82, 0.9);
}

.mod-chip.warn {
    background-color: rgba(140, 90, 40, 0.85);
}

.mod-chip.positive {
    background-color: rgba(40, 110, 70, 0.85);
}

.mod-chip.empty {
    color: rgb(110, 116, 130);
    background-color: transparent;
    padding-left: 0;
}

.god-hint {
    color: rgb(140, 146, 160);
    font-size: 10px;
    margin-bottom: 2px;
    white-space: normal;
}

.god-row {
    margin-bottom: 2px;
}

.btn.god {
    font-size: 11px;
    padding-left: 6px;
    padding-right: 6px;
}

.offline-pack-title {
    color: rgb(230, 235, 245);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    white-space: normal;
}

.offline-pack-synopsis {
    color: rgb(170, 180, 200);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 8px;
}

.offline-now-label {
    color: rgb(200, 210, 170);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 4px;
}

.observe-now-header {
    color: rgb(210, 195, 150);
    font-size: 12px;
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 4px;
}

.npc-nameplate {
    position: absolute;
    min-width: 72px;
    max-width: 140px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: rgba(10, 12, 18, 0.78);
    color: rgb(245, 247, 252);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.npc-nameplate.nameplate--selected {
    background-color: rgba(40, 100, 200, 0.88);
}
.show-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-grow: 1;
}

.show-hud.hidden,
.show-face.hidden {
    display: none;
}

.show-face {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 28px 36px;
}

.show-face-landing,
.show-face-quiz,
.show-face-episode-end,
.show-face-season-end {
    background-color: rgba(8, 12, 18, 0.82);
    align-items: center;
    justify-content: center;
}

.landing-season {
    font-size: 14px;
    color: rgb(180, 190, 200);
    margin-bottom: 8px;
}

.landing-title {
    font-size: 32px;
    color: rgb(245, 242, 235);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.landing-tagline {
    font-size: 15px;
    color: rgb(200, 205, 210);
    white-space: normal;
    max-width: 520px;
    -unity-text-align: middle-center;
    margin-bottom: 28px;
}

.show-btn {
    min-height: 36px;
    padding: 8px 18px;
    margin: 6px;
    background-color: rgb(42, 52, 64);
    color: rgb(235, 238, 242);
    border-width: 0;
    border-radius: 6px;
    font-size: 14px;
}

.show-btn.primary {
    background-color: rgb(196, 92, 78);
}

.show-btn.ghost {
    background-color: rgba(255, 255, 255, 0.08);
}

.show-btn.tiny {
    min-height: 28px;
    padding: 4px 10px;
    font-size: 12px;
}

.show-face-playback {
    justify-content: space-between;
}

.playback-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.playback-segment {
    font-size: 16px;
    color: rgb(245, 242, 235);
    background-color: rgba(0, 0, 0, 0.35);
    padding: 6px 12px;
    border-radius: 4px;
}

.playback-rule {
    font-size: 12px;
    color: rgb(210, 215, 220);
    background-color: rgba(0, 0, 0, 0.35);
    padding: 6px 12px;
    border-radius: 4px;
    max-width: 420px;
    white-space: normal;
    -unity-text-align: middle-right;
}

.playback-caption {
    align-self: center;
    max-width: 640px;
    font-size: 18px;
    color: rgb(250, 248, 242);
    background-color: rgba(0, 0, 0, 0.45);
    padding: 10px 18px;
    border-radius: 6px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 40px;
}

.playback-bottom {
    background-color: rgba(6, 10, 16, 0.55);
    padding: 12px 16px;
    border-radius: 8px;
}

.monologue-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.monologue-who {
    font-size: 13px;
    color: rgb(255, 196, 140);
    margin-right: 10px;
    min-width: 64px;
}

.monologue-text {
    flex-grow: 1;
    font-size: 14px;
    color: rgb(230, 232, 236);
    white-space: normal;
}

.relation-bar {
    font-size: 12px;
    color: rgb(180, 190, 200);
    margin-bottom: 10px;
    white-space: normal;
}

.playback-controls {
    flex-direction: row;
    align-items: center;
}

.quiz-focus {
    font-size: 14px;
    color: rgb(200, 205, 210);
    margin-bottom: 8px;
}

.quiz-question {
    font-size: 28px;
    color: rgb(245, 242, 235);
    -unity-font-style: bold;
    margin-bottom: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 560px;
}

.quiz-hint {
    font-size: 14px;
    color: rgb(170, 180, 190);
    margin-bottom: 24px;
    white-space: normal;
    max-width: 480px;
    -unity-text-align: middle-center;
}

.quiz-options {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 640px;
}

.quiz-option {
    min-width: 140px;
    min-height: 48px;
    margin: 8px;
    font-size: 16px;
    background-color: rgb(54, 68, 86);
    color: rgb(245, 242, 235);
    border-radius: 8px;
    border-width: 0;
}

.end-title {
    font-size: 28px;
    color: rgb(245, 242, 235);
    margin-bottom: 16px;
}

.end-quiz-result {
    font-size: 16px;
    color: rgb(220, 230, 200);
    margin-bottom: 10px;
}

.end-monologue {
    font-size: 14px;
    color: rgb(200, 205, 210);
    white-space: normal;
    max-width: 520px;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.end-highlights-label {
    font-size: 13px;
    color: rgb(180, 190, 200);
    margin-bottom: 8px;
}

.end-highlights {
    flex-direction: column;
    align-items: stretch;
    max-width: 520px;
    margin-bottom: 16px;
}

.highlight-btn {
    margin: 4px 0;
    padding: 10px 14px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(235, 238, 242);
    border-width: 0;
    border-radius: 6px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.end-teaser {
    font-size: 13px;
    color: rgb(170, 180, 190);
    white-space: normal;
    max-width: 480px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.end-actions {
    flex-direction: row;
}

.season-end-title {
    font-size: 28px;
    color: rgb(245, 242, 235);
    margin-bottom: 12px;
}

.season-end-body {
    font-size: 15px;
    color: rgb(190, 200, 210);
    margin-bottom: 24px;
}

