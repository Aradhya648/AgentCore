# 环境隔离（可选，进程环境变量，勿把真实密钥提交进仓）：
# AGENTCORE_ENV 默认 development → 读本目录 .env；其它值优先 .env.{env}（不存在则回退 .env）。
# AGENTCORE_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://agentcore:agentcore@localhost:5432/agentcore
# Integration tests run against isolated per-process `agentcore_it_<pid>` schemas.
# Optional: defaults to DATABASE_URL when unset. Point at a throwaway server in CI.
# TEST_DATABASE_URL=postgresql+asyncpg://agentcore:agentcore@localhost:5432/agentcore

# Redis
REDIS_URL=redis://localhost:6379/0

# BYOK 用户自带 key 在应用「设置·模型配置」保存，不落 .env。
# eval 真跑凭据用独立变量 EVAL_DEEPSEEK_*（见 agentcore/evals/harness.py），非平台配置。

# 平台 LLM 上游（billing_mode=platform 走此三项；OpenAI 兼容）。
# pydantic-settings 字段：platform_api_key / platform_base_url / platform_model
# 须与下方 PLATFORM_MODELS / CNY curated 价卡一致（缺卡不上架）。示例：
# PLATFORM_API_KEY=sk-your-platform-key
# PLATFORM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# PLATFORM_MODEL=glm-5.2

# 平台模型目录 allowlist（billing_mode=platform 主路，成本配额与计费.md §〇·六 F3）：
# 逗号分隔的模型 id = 平台目录 + 系统预置投影源。空 = 回退 [PLATFORM_MODEL, 后台档]
# （无 membership 冲突校验）。非空时 PLATFORM_MODEL 与（若配置）PLATFORM_BACKGROUND_MODEL
# 必须 ∈ 本列表，否则**启动失败**（settings fail-fast，勿 silent）。每个上架 id 必须有
# CNY curated 价卡（F4：缺价 → 不上架）。勿默认无 CNY 价卡的 grok。发现全量上游仅留给 BYOK 行。
# PLATFORM_MODEL=glm-5.2
# PLATFORM_MODELS=glm-5.2,deepseek-v4-flash

# 平台每模型凭据覆盖（「一 key 一模型」中转，成本配额与计费.md §〇·六 F3）：
# 单行 JSON {model id → {"api_key"?, "base_url"?}}。缺字段回退 PLATFORM_API_KEY / PLATFORM_BASE_URL；
# 空 = 全部走默认 key。示例：
# PLATFORM_MODEL_CREDENTIALS={"glm-5.2":{"api_key":"sk-glm-key","base_url":"https://relay.example/openai/v1"}}

# 无独立免费档。byok 部署无 Key → 402；platform 代付走下方 quota_*（¥10/月 · ¥10/日 · 500 请求/日）。

# Sub2API 管理 API（可选）。配置后 503 时自动探测账号状态生成诊断。
# SUB2API_ADMIN_URL=http://localhost:8080
# SUB2API_ADMIN_EMAIL=admin@sub2api.local
# SUB2API_ADMIN_PASSWORD=your-admin-password

# 计费模式：byok（默认，用户自带 Key）| platform（运营方代付，BYOK 降级为高级选项）。
# 内测计费翻转（成本配额与计费.md §〇·六）：生产切 platform + 合作中转上游 + PLATFORM_MODELS
# allowlist 目录 + quota_* 限额组（¥10/月 · ¥10/日 · 500 请求/日，见下方 Cost & quotas）。
# dev 默认仍 byok（不破坏本地开发流）；回滚 = 改回 byok。
# BILLING_MODE=byok

# 多模型辩手 vendor（OpenAI 兼容，经 ProviderRouter 按 provider/model 前缀路由）。空 key = 不
# 注册，路由回退 DeepSeek（零回归）。base_url 须含版本前缀。Doubao 调用时 model 传【接入点 ID
# (ep-…) 或已开通的模型 ID】，单有 key 点不到模型。本地真实 key 放 .env（gitignored），勿提交。
# MOONSHOT_API_KEY=                  # Kimi（前缀 kimi）
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# ZHIPU_API_KEY=                     # 智谱 GLM（前缀 zhipu）
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DOUBAO_API_KEY=                    # 豆包 / 火山方舟（前缀 doubao）
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# AI 协作白板 读图 (docs/04-前端/AI协作白板.md §九.4). 视觉 provider（OpenAI 兼容多模态端点）：
# board_read 把白板上的手绘 / 截图栅格化成 PNG 交它解读。**空 key = 不启用**——board_read 返回
# 干净「读图能力未配置」错误；填 key 即「插上即用」，无需改代码。默认 qwen-vl-max（阿里云百炼
# DashScope 兼容端点，已在 pricing 表定价）；换模型改 VISION_BASE_URL/VISION_MODEL 指向任意
# OpenAI 兼容视觉端点（GLM-4V / GPT-4o / 豆包 / 本地 vLLM…），未在 pricing 表的新模型按 Flash 档
# 计价 + 告警直到补价。视觉子调用按 role=vision 单独入 cost_events 账本。
# VISION_API_KEY=
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL=qwen-vl-max
# VISION_TIMEOUT_SECONDS=60

# BYOK 凭据加密主密钥 (AES-256-GCM, 64 hex = 32 字节). billing_mode=byok (默认) 下必填，
# 缺失则模型配置页无法保存 API Key、对话不可用。
# `cp .env.example .env` 后必须先生成并填入真实 key，占位值不可用：
#   python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️ 切勿把下方占位用于生产（见 deploy/config/production.env.example）。
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# Web search — self-hosted SearXNG (see deploy/docker-compose.dev.yml +
# deploy/searxng/settings.yml). Engines curated to mainland-China-reachable ones.
SEARXNG_URL=http://localhost:18888

# Tavily fallback search (optional). When set, a web_search that FAILS on SearXNG
# (breaker-open / transport / persistent 5xx) retries once via Tavily — a hosted
# search API reachable outside mainland China. SearXNG stays primary (no per-query
# Tavily cost); Tavily fires only on a primary failure. Empty = disabled (pure
# SearXNG, unchanged). Get a key at https://tavily.com.
# TAVILY_API_KEY=tvly-your-key-here
# TAVILY_BASE_URL=https://api.tavily.com

# read_url exfil hard-guard (PI-002). Default false = OBSERVE only: a read_url of a NOVEL
# domain (one no web_search surfaced this conversation) carrying a long opaque query is
# logged as tool.read_url_novel_domain (the indirect-injection ?d=<secret> exfil tell) but
# still fetched. Set true to REFUSE such requests instead — closes the silent-exfil path at
# the cost of some friction on user-pasted / model-constructed long-query links. See
# 项目审计-提示注入专项 §五 PI-002.
# READ_URL_BLOCK_NOVEL_QUERY=false

# Clash/Mihomo fake-IP: DNS answers 198.18.x.x placeholders. Default true lets read_url
# dial through the local proxy while still blocking real private/loopback IPs. Set false
# for strict SSRF (requires proxy redir-host / no fake-ip) — see scripts/probe_egress.py.
# READ_URL_ALLOW_FAKE_IP_PROXY=true

# JWT — MUST be a strong random secret in production. Boot refuses known
# placeholders unless DEBUG=true *and* ALLOW_INSECURE_JWT_SECRET=true (local only).
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
ALLOW_INSECURE_JWT_SECRET=true
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh tokens rotate + slide on every use, capped by REFRESH_FAMILY_MAX_DAYS
# (admin: ADMIN_REFRESH_FAMILY_MAX_HOURS). This is the max idle gap before a re-login.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Absolute ceiling on a refresh family from first login (product default 90d).
REFRESH_FAMILY_MAX_DAYS=90
# Tighter absolute ceiling for admin-audience families (hours).
ADMIN_REFRESH_FAMILY_MAX_HOURS=24
# Absolute ceiling when login persist_session=false (session cookie / short bearer TTL).
EPHEMERAL_REFRESH_FAMILY_MAX_HOURS=8
# GC retention for terminal refresh rows (rotated/revoked/expired); keep for reuse detection.
REFRESH_TOKEN_RETENTION_DAYS=7
INFERENCE_TOKEN_EXPIRE_MINUTES=120
INFERENCE_TOKEN_MINT_MAX=10
INFERENCE_TOKEN_MINT_WINDOW_SECONDS=60

# Auth cookies — set BOTH for production (HTTPS): COOKIE_SECURE=true and,
# once the client origin is fixed, COOKIE_SAMESITE=strict.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Refresh-cookie path prefix — leave empty in dev (API at root). In prod set to the
# reverse-proxy mount prefix (e.g. /api) so the cookie rides /api/v1/auth/refresh.
COOKIE_PATH_PREFIX=

# CORS — origins allowed to call the API with credentials (comma-separated).
# Credentialed CORS forbids "*", so list your deployed web origin(s) explicitly.
# NOTE: an Electron production build loads via file:// (Origin "null") and cannot
# use cookies cross-site to a remote API — serve the web app same-site with the
# API (reverse proxy) for browser/desktop cookie auth.
# 5173 = desktop renderer dev; 5174 = admin console dev (apps/admin).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,app://agentcore

# CSRF synchronizer token for cookie-session clients (admin / desktop). Bearer mobile skips.
CSRF_ENABLED=true

# Public registration (开放注册). Default open; set false to emergency-close signups.
REGISTRATION_OPEN=true

# Rate limit backend: memory (single worker) or redis (multi-worker + shared CSRF store).
RATE_LIMIT_BACKEND=memory

# Auth rate limiting (per client IP, fixed window) for login/register/refresh.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Trust X-Forwarded-For's first hop for the client IP. Enable ONLY behind a
# trusted reverse proxy that sets it (otherwise clients can spoof their IP).
TRUST_PROXY=false

# Cost & quotas — money is integer nano-CNY (1 CNY = 1e9). API no longer ships FX.
# A quota of 0 = unlimited.
# 全局 quota_*（platform 代付）= 月成本 ¥10 + 日成本 ¥10 + 500 请求/日；日 token 维置 0
# （退出值守——多模型目录单价差 ~30×, token 帽映射不了钱, 由日成本维兜底）。
QUOTA_DAILY_TOKENS=0
QUOTA_MONTHLY_COST_CNY=10
QUOTA_DAILY_COST_CNY=10
QUOTA_DAILY_REQUESTS=500

# Cloud workspace: code_execute runs in a plain subprocess on the API host — NOT an
# isolation boundary (full API-process privileges: filesystem, egress, in-process
# secrets). Default false; local/sidecar (location=local) keeps code_execute + approval
# gate. Turning it on in a non-debug server ALSO requires CODE_EXECUTE_CLOUD_UNSAFE_ACK
# (the server refuses to boot otherwise) and should only be done behind a real sandbox
# (container/gVisor/nsjail). With GVISOR_ENABLED=true the gVisor sandbox is used
# instead and CODE_EXECUTE_CLOUD_UNSAFE_ACK is not required. See SEC-005.
# CODE_EXECUTE_CLOUD_ENABLED=false
# CODE_EXECUTE_CLOUD_UNSAFE_ACK=false
#
# ── gVisor 云端执行（安全 §五；生产默认关、待发布启用）──
# 开启前置：镜像含 runsc + 叠 docker-compose.sandbox.yml（deploy-server /
# finish-server 在 GVISOR_ENABLED=true 时自动叠）。灰度护栏默认保守（2C8G）。
# GVISOR_ENABLED=false
# GVISOR_RUNSC_PATH=runsc
# 默认 ./data/sandbox（对齐 DATA_DIR）；勿用 /tmp（gVisor 在容器 overlay 上会 EINVAL）
# GVISOR_RUNTIME_ROOT=./data/sandbox
# GVISOR_MAX_CONCURRENT_EXECUTIONS=2
# GVISOR_SLOT_WAIT_SECONDS=15
# GVISOR_MEMORY_LIMIT_MB=512
# GVISOR_TIMEOUT_MAX_SECONDS=60
# GVISOR_STAGE_MAX_BYTES=536870912
# GVISOR_WRITE_BACK_MAX_BYTES=134217728
# GVISOR_WRITE_BACK_MAX_FILES=200
# Server
# Windows 若 8000 无法绑定：多因 Hyper-V/WSL 把 TCP 动态端口区间改低（如 1024-15000）。
# 管理员执行 `netsh int ipv4 set dynamicport tcp start=49152 num=16384` 再重启 winnat 可回收。
HOST=0.0.0.0
PORT=8000
DEBUG=true
# Optional. Unset = WatchFiles follows DEBUG. Set false for long live collaboration
# runs (keeps DEBUG=true logs/auto-migrate, disables hot-reload). Restore: unset or true.
# AGENTCORE_RELOAD=false

# Desktop auto-update kill switch (前端技术与架构.md §7.6). The desktop updater polls
# GET /updates/policy before each check; set false to pause rollout of a bad release.
# Default true; clients fail-open (an API outage never strands them without updates).
# DESKTOP_UPDATES_ENABLED=true

# Soft minimum desktop version (部署与运维.md §7.6). Exposed as
# GET /updates/policy → min_desktop_version. Empty (default) = no outdated banner
# (dev-friendly). Production should set the oldest supported install, e.g. 0.6.5.
# DESKTOP_MIN_VERSION=0.6.5

# 原生推送 (FCM, 认证与会话 §十). 默认关闭：未启用时 turn 零开销（不查库、不发送）。
# 启用需在 Firebase 控制台为项目创建服务账号并下载其 JSON（含 client_email/private_key/
# project_id），把路径填入 FCM_SERVICE_ACCOUNT_PATH。无需新增 Python 依赖（用 python-jose
# 签名 + httpx 兑换 OAuth2 token）。FCM_PROJECT_ID 留空则取 JSON 里的 project_id。
# PUSH_ENABLED=false
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# 法律垂直上架总闸 (docs/06-规划/远期规划.md §4.5). When false (default), the legal
# capability pack is invisible and not registered — same outward posture as before.
# When true, the pack appears in GET /v1/capabilities packs[] and its skills are
# registered for every user (no per-user toggle).
# LEGAL_VERTICAL_ENABLED=false

# Logging — LOG_LEVEL: debug/info/warning/error. LOG_FILE: when set, the runtime
# also writes one JSON object per line (JSONL, no ANSI) to this path — the
# queryable 产品AI日志 that scripts/log_*.py + .cursor/rules/conversation-logs.mdc
# read. Relative paths resolve against the repo root; empty = stdout only (prod).
# Dev recommendation: logs/dev.jsonl (gitignored). SQL echo is a separate switch.
LOG_LEVEL=info
LOG_FILE=logs/dev.jsonl
# DB_ECHO=false  # set true only to dump SQL statements when diagnosing a query
# LLM prompt/response bodies (llm.request/llm.response) — truncated + secret-redacted.
# Dev default ON so the 产品AI日志 carries what the model actually saw/said (prompt tuning +
# letting an AI optimise prompts). Single switch: emits at info, so no LOG_LEVEL=debug needed.
# Set false to disable; keep OFF in prod (bodies are large + sensitive).
LOG_LLM_BODIES=true
