# Backend base URL — only needed when NOT using the dev same-origin proxy (see below).
#
# • `pnpm dev` (default): leave UNSET. API calls go to same-origin `/api/*`, proxied by Vite
#   to localhost:8000 — works on PC and on a phone at http://<host-lan-ip>:5175/ with zero
#   per-IP CORS / env hacks.
# • Override (optional): set an absolute URL to hit a remote staging API while running Vite.
#
# Production (Pages / static host): baked by `.env.production` or deploy script —
#   VITE_API_URL=https://app.fashitianxia.xyz/api
# (must include the /api reverse-proxy prefix; see scripts/deploy-pages.mjs).
# VITE_API_URL=https://app.fashitianxia.xyz/api

# Native FCM — only set true when android/app/google-services.json exists.
# release:android sets this automatically. Never enable without that file (Android crash).
# VITE_PUSH_ENABLED=false

# 开发期自动登录（可选，仅 DEV 构建生效，生产/Capacitor 构建会被静态剔除）。
# 配好后打开手机端会走真实 /v1/auth/token 流程自动取 bearer token 登录，免去每次手输；
# 不绕过后端认证，只是自动化一次正常登录。沿用桌面端同名变量与同一个 seed 用户。
# 用法：先在后端执行 `uv run python scripts/seed_dev_user.py` 创建同名用户，
# 再把真实值写进 apps/mobile/.env.local（已被 gitignore，勿提交）。
# VITE_DEV_USERNAME=dev
# VITE_DEV_PASSWORD=devpassword
