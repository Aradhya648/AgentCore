# Release signing (DO NOT commit the real file — gitignored).
# Copy to keystore.properties next to this example and fill in values.
#
# storeFile is resolved relative to the android/ project root
# (apps/mobile/android/), or use an absolute path.

storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=agentcore
keyPassword=CHANGE_ME
