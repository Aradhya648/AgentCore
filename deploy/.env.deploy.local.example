# Copy to deploy/.env.deploy.local (gitignored). Never commit real values.

# Cloudflare Pages (website + mobile)
CLOUDFLARE_API_TOKEN=
# Cloudflare Account ID（Dashboard → Workers & Pages → Account ID；勿提交真实值）
CLOUDFLARE_ACCOUNT_ID=

# Brand download host (self-hosted nginx · sync:release-cdn / release:win / release:android)
# 一次性：pnpm sync:release-cdn --install-nginx，再在 CF Tunnel 加 Public Hostname → §7.6b
# AGENTCORE_DOWNLOADS_BASE=https://downloads.fashitianxia.xyz
# AGENTCORE_DOWNLOADS_HOST=downloads.fashitianxia.xyz
# AGENTCORE_DOWNLOADS_ROOT=/opt/agentcore/downloads

# Production SSH (admin deploy, backend remote-build-deploy.mjs, sync:release-cdn,
# pnpm sync:logs / scripts/sync-prod-logs.mjs, optional CORS patch)
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_KEY_PATH=
DEPLOY_SSH_PORT=22

# Admin / mobile / web deploy hosts（可选；脚本已有 fashitianxia 默认值）
# AGENTCORE_APP_HOST=app.fashitianxia.xyz
# AGENTCORE_OFFICE_HOST=office.fashitianxia.xyz
# AGENTCORE_APP_API_URL=https://app.fashitianxia.xyz/api
