{
  "name": "agentcore",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "conformance": "pnpm -r run conformance",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:story-packs": "node scripts/sync-story-packs.mjs",
    "gen:story-packs:check": "node scripts/sync-story-packs.mjs --check",
    "sync:legal": "node scripts/sync-legal-md.mjs",
    "sync:legal:check": "node scripts/sync-legal-md.mjs --check",
    "bump-version": "node scripts/bump-version.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release:gate:lite": "node scripts/release-gate.mjs --lite",
    "audit:deps:py": "cd apps/server && uv run --with pip-audit pip-audit",
    "audit:deps:js": "pnpm audit --prod",
    "audit:deps": "node scripts/audit-deps.mjs",
    "test:server": "cd apps/server && uv run pytest --tb=short -q",
    "test:server:unit": "cd apps/server && uv run pytest --ignore=tests/integration --tb=short -q -n auto",
    "test:server:cov": "cd apps/server && uv run pytest --cov=agentcore --cov-report=term-missing --ignore=tests/integration --tb=short -q",
    "test:server:slow": "cd apps/server && uv run pytest --durations=20 -q",
    "deploy:backend": "node deploy/scripts/remote-build-deploy.mjs",
    "deploy:backend:status": "node deploy/scripts/check-remote-build.mjs",
    "publish:notice": "node deploy/scripts/publish-product-notice.mjs",
    "sync:release-cdn": "node deploy/scripts/sync-release-cdn.mjs",
    "sync:logs": "bash scripts/sync-prod-logs.sh",
    "town:build": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/build-unity.ps1",
    "town:build:webgl": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/build-unity.ps1 -Target WebGL",
    "town:spike:webgl": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/spike-webgl-sse.ps1",
    "town:serve:webgl": "node apps/town/scripts/serve-webgl.mjs",
    "town:shoot:webgl": "node apps/town/scripts/shoot-webgl-demo.mjs",
    "town:verify": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/verify-unity.ps1",
    "town:perf": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/perf-unity.ps1",
    "town:open": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/open-unity.ps1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "node-pty"
    ],
    "overrides": {
      "@radix-ui/react-slot": "1.3.0",
      "esbuild": "^0.25.0",
      "js-yaml": "^4.2.0"
    }
  }
}
